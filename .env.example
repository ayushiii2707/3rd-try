# Optional. Copy to .env (never commit .env). `npm start` works without it.

# Model access for the idea (Elephant–Goldfish) workflow. Leave unset to run
# without AI; repository onboarding works either way.
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini

# Server address. Defaults: 127.0.0.1:8787
# PORT=8787

# SQLite database file. Default: .data/adis-local.sqlite
# LOCAL_DB_PATH=.data/adis-local.sqlite

# Credential encryption key (base64, 32 bytes). Leave unset: on first start the
# server creates .data/credential.key and reuses it. Only set this to share an
# existing key; changing it makes stored repository credentials unreadable.
# CREDENTIAL_ENCRYPTION_KEY=
