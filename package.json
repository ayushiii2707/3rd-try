{
  "name": "adis-project-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/local-backend.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch-path=worker --watch-path=scripts scripts/local-backend.mjs",
    "build": "bash scripts/build.sh",
    "validate": "node --disable-warning=ExperimentalWarning scripts/validate-artifact.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:integration": "node --disable-warning=ExperimentalWarning --test test/*.integration.test.js"
  }
}
